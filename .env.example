# Copy this file to .env and replace the placeholders for your local services.
PII_PRIVACY_URL=http://127.0.0.1:8081
PII_LLM_URL=http://127.0.0.1:8080/v1/chat/completions
PII_LLM_MODEL=local-model
PII_LLM_API_KEY=
PII_LLM_REASONING_EFFORT=low

# Generate once with: openssl rand -hex 32
PII_VAULT_KEY=
PII_DEMO_VAULT_DB=.private/state/demo-vault.sqlite3
PII_DEMO_HOST=127.0.0.1
PII_DEMO_PORT=8765
